        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.28.0",
        "recharts": "^2.13.3"
    },
    "devDependencies": {
        "@dhis2/cli-app-scripts": "12.10.4",
        "@types/react": "^18.3.1",
        "@types/react-dom": "^18.3.1",
        "acorn": "^8.16.0",
        "eslint": "^8.57.0"
    }
