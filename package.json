    "long_description": "Maternal Health Risk Alert helps antenatal care teams screen pregnancies for risk using DHIS2 tracker data and evidence-based rules.",
    "author": {
        "name": "Maternal Health Development Team",
        "url": "https://github.com/mljadama/maternal-health-risk-alert"
    },
    "keywords": ["maternal-health", "antenatal-care", "pregnancy", "risk-assessment", "tracker", "clinical-decision-support"],
    "license": "BSD-3-Clause",
    "private": true,
    "scripts": {
        "start": "PORT=3001 d2-app-scripts start",
        "build": "d2-app-scripts build",
        "test": "d2-app-scripts test",
        "postinstall": "node scripts/apply-dhis2-windows-patches.js",
        "deploy": "d2-app-scripts deploy",
        "lint": "d2-app-scripts lint"
    },
    "dependencies": {
        "@dhis2/app-runtime": "^3.10.0",
        "@dhis2/ui": "^9.0.0",
        "@emotion/react": "^11.14.0",
